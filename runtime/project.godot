; UGC Runtime - data-driven Godot game player for the AI UGC platform
config_version=5

[application]

config/name="UGC Runtime"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

G="*res://kit.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://ui_font.tres"
theme/default_font_size=24

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_interpolation=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.53, 0.81, 0.92, 1)
